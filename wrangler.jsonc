{
  // The Klaro landing site: plain static files served by a Worker with static assets. There is no
  // build step. Files are answered straight from the assets; a small Worker script
  // (worker/index.js) runs only for the videos (Range requests, so players can seek) and for URLs
  // that match no file (the 404 page, never cached). Why: design/brief/cloudflare.md §2.5.
  // How it is deployed, previewed and rolled back: design/brief/cloudflare.md.
  //
  // One Worker in the Klaro account serves klaroplatform.com (the canonical address) and
  // learnklaro.com (moved into this account on 2026-10-13). Deployed by hand, from a clean checkout:
  //   npx wrangler deploy            (goes live on all four hostnames: the owner or orchestrator only)
  //   npx wrangler versions upload   (a preview URL only)
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  // "Klaroplatform's Account", the one the app's Workers are in. It holds both zones.
  "account_id": "bbcdececfdc25f78201b3be407c7de6e",
  // Must match the Worker's name in the dashboard, or Workers Builds refuses to build.
  "name": "klaro-landing",
  "compatibility_date": "2026-09-11",
  // Runs only for the videos and for misses (see "assets" below). It must stay out of the published
  // files: .assetsignore lists /worker. It replaces worker.js on main (Omar's Range Worker, 8a428a9).
  "main": "worker/index.js",
  "assets": {
    // The repository root is the site. .assetsignore keeps the notes, designs and tooling out;
    // _headers sets security and cache headers (it is read by Cloudflare, not served).
    "directory": ".",
    // The Worker script reaches the files through this binding (env.ASSETS).
    "binding": "ASSETS",
    // Videos go to the Worker first: static assets answer Range requests with the whole file, and
    // players need 206 to seek. Only .mp4 files, so posters, captions and images never invoke it.
    // Static asset requests are free and unlimited; Worker invocations count against the Free
    // plan's 100,000 a day.
    "run_worker_first": ["/media/*.mp4", "/demo/*.mp4"],
    // "none", not "404-page": every URL that matches no file then goes to the Worker, which sends
    // 404.html with status 404 and "Cache-Control: no-store". With "404-page" (and a
    // run_worker_first list) the assets would answer misses themselves, with the folder's
    // _headers Cache-Control, so a 404 under /media/ would be kept by browsers for a day.
    "not_found_handling": "none",
    // The default, written out: /products/study-view redirects to /products/study-view/ and serves
    // products/study-view/index.html; /index.html redirects to /.
    "html_handling": "auto-trailing-slash"
  },
  // Cloudflare creates the DNS records and certificates for these custom domains. It refuses if the
  // zone already has an A, AAAA or CNAME record on the apex or on www, so remove any such record
  // first. Keep both www hosts even though www.klaroplatform.com redirects to the apex: the redirect
  // (a Redirect Rule in the zone's dashboard, not code) needs the record and the certificate.
  "routes": [
    { "pattern": "klaroplatform.com", "custom_domain": true },
    { "pattern": "www.klaroplatform.com", "custom_domain": true },
    { "pattern": "learnklaro.com", "custom_domain": true },
    { "pattern": "www.learnklaro.com", "custom_domain": true }
  ],
  // No public <name>.<subdomain>.workers.dev copy of the site (this is also what the routes imply).
  "workers_dev": false,
  // Version URLs (<version>-klaro-landing.<subdomain>.workers.dev) stay on, so a version can be
  // checked before it is promoted (`wrangler versions upload`). They are public; _headers marks them
  // noindex so search engines keep to klaroplatform.com.
  "preview_urls": true
}
