{
  // Two targets. The default one (below) is learnklaro.com: it serves no files and only redirects
  // every request to the same address on klaroplatform.com (worker/redirect.js, 301, path and query
  // kept). The site itself is the "klaroplatform" env further down: plain static files served by a
  // Worker with static assets, no build step. Its small script (worker/index.js) runs only for the
  // videos (Range requests, so players can seek) and for URLs that match no file (the 404 page,
  // never cached). Why: design/brief/cloudflare.md §2.5. Deploys, previews, rollback: same file.
  //
  // Workers Builds (Git integration, set up in the dashboard) runs `npx wrangler deploy` from `main`
  // for the default target, so a push to `main` deploys the learnklaro.com redirect.
  // By hand, from a clean checkout:
  //   CLOUDFLARE_ACCOUNT_ID=8f32b3259e15052339fe39a63baa1cca npx wrangler deploy            (goes live)
  //   CLOUDFLARE_ACCOUNT_ID=8f32b3259e15052339fe39a63baa1cca npx wrangler versions upload   (preview URL only)
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  // Must match the Worker's name in the dashboard, or Workers Builds refuses to build.
  "name": "klaro-landing",
  "compatibility_date": "2026-09-11",
  // Answers every request with a redirect to klaroplatform.com. No "assets" here on purpose: with
  // static assets a file would be served before the script could redirect.
  "main": "worker/redirect.js",
  // learnklaro.com lives in the owner's second account, so every wrangler command needs
  // CLOUDFLARE_ACCOUNT_ID=8f32b3259e15052339fe39a63baa1cca. Cloudflare creates the DNS records and
  // certificates for these custom domains. Both hosts redirect straight to https://klaroplatform.com.
  "routes": [
    { "pattern": "learnklaro.com", "custom_domain": true },
    { "pattern": "www.learnklaro.com", "custom_domain": true }
  ],
  // No public <name>.<subdomain>.workers.dev copy (this is also what the routes imply).
  "workers_dev": false,
  // Version URLs (<version>-klaro-landing.<subdomain>.workers.dev) stay on, so a version can be
  // checked before it is promoted (`wrangler versions upload`).
  "preview_urls": true,

  // The same site on klaroplatform.com, the canonical address (tools/site.json "base"). The zone
  // klaroplatform.com lives in the OTHER Cloudflare account ("Klaroplatform's Account", the one the
  // app's Workers are in), so this target carries its own account_id and Worker, with the same files
  // and the site's Worker script (worker/index.js). The default config above only redirects learnklaro.com here.
  //   npx wrangler deploy --env klaroplatform            (goes live: the owner or orchestrator only)
  //   npx wrangler versions upload --env klaroplatform   (a preview URL only)
  // wrangler does not inherit `routes`, `assets` or `name` into an env reliably, so each is written
  // out in full. Cloudflare creates the DNS records and certificates for the two custom domains; it
  // refuses if the zone already has an A, AAAA or CNAME record on the apex or on www, so remove any
  // such record first. The www -> apex 301 is a Redirect Rule in the zone's dashboard, not code
  // (design/brief/cloudflare.md §6). This env sets no response headers: _headers is shared, and its
  // only noindex rule is for *.workers.dev, so klaroplatform.com is indexable.
  "env": {
    "klaroplatform": {
      // A different account from the default target, so the Worker can keep the same name.
      "account_id": "bbcdececfdc25f78201b3be407c7de6e",
      "name": "klaro-landing",
      "compatibility_date": "2026-09-11",
      "main": "worker/index.js",
      "assets": {
        "directory": ".",
        "binding": "ASSETS",
        "run_worker_first": ["/media/*.mp4", "/demo/*.mp4"],
        "not_found_handling": "none",
        "html_handling": "auto-trailing-slash"
      },
      "routes": [
        { "pattern": "klaroplatform.com", "custom_domain": true },
        // Keep www here even though it redirects to the apex: the redirect rule needs its DNS record
        // and certificate.
        { "pattern": "www.klaroplatform.com", "custom_domain": true }
      ],
      "workers_dev": false,
      "preview_urls": true
    }
  }
}
