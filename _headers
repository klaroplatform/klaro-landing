# Response headers for the Klaro site (klaroplatform.com; learnklaro.com only redirects there and serves no files),
# applied by Cloudflare (Workers static assets). Nothing here is host-specific except the workers.dev rule
# below, so neither real domain is ever marked noindex.
# This file is read by Cloudflare and is never served. GitHub Pages ignores it (Jekyll skips "_" files).
# Docs: https://developers.cloudflare.com/workers/static-assets/headers/
#
# Rules: a block starts with a URL pattern; indented lines are headers. One "*" per pattern.
# When two blocks match one URL and set the same header, the values are JOINED with a comma, so
# never set the same header (Cache-Control above all) in two blocks that can match one URL.
# At most 100 blocks. Check after a change: curl -sI <preview URL>/<path>
#
# A rule applies to EVERY response the assets build for a matching URL, 404s and redirects
# included: a missing /media/x.mp4 would get /media/*'s Cache-Control too. That is why every miss
# goes to worker/index.js, which sends the 404 page with "Cache-Control: no-store" (wrangler.jsonc
# "not_found_handling": "none"; cloudflare.md §2.5). The cache rules below therefore only reach
# files that exist, and redirects. Keep HTML pages out of the long-cached folders: their
# trailing-slash redirects (307) would be cached as long as the files. The Worker's video answers
# (206) keep these headers: it copies them from the file.

# Security headers on every response. SAMEORIGIN lets our own pages frame the showcase and nobody
# else. No Content-Security-Policy: the pages use inline styles, inline JSON-LD and Google Fonts, and
# the showcase needs frame, media, worker and connect sources (showcase.md §7.3), so a CSP needs its
# own careful pass.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), browsing-topics=()

# Version URLs (<version>-klaro-landing.<subdomain>.workers.dev) and any workers.dev copy are
# public but must not be indexed: search engines keep to klaroplatform.com (the canonical host).
https://:version.:subdomain.workers.dev/*
  X-Robots-Tag: noindex

# Caching. HTML gets Cloudflare's default (public, max-age=0, must-revalidate, plus an ETag), so a
# deploy shows at once; nothing below matches an HTML URL.
# The landing's own CSS and JS are not fingerprinted (no hash in the file name), so they are cached
# for 5 minutes only: after a deploy, a returning visitor can get new HTML with old CSS for at most
# that long. They are listed by name, NOT as /*.css and /*.js: those would also match the
# showcase's hashed files, and two Cache-Control values on one URL get joined. A new CSS or JS file
# that isn't listed here simply gets the HTML default (always revalidated), which is safe.
/klaro.css
  Cache-Control: public, max-age=300, must-revalidate

/site.css
  Cache-Control: public, max-age=300, must-revalidate

/klaro.js
  Cache-Control: public, max-age=300, must-revalidate

/site.js
  Cache-Control: public, max-age=300, must-revalidate

/showcase.js
  Cache-Control: public, max-age=300, must-revalidate

/market/market.css
  Cache-Control: public, max-age=300, must-revalidate

/market/market.js
  Cache-Control: public, max-age=300, must-revalidate

/v1/klaro.css
  Cache-Control: public, max-age=300, must-revalidate

# The showcase: the real app on sample data, built into /showcase/ (design/brief/showcase.md §7).
# It is not for search results (showcase.html also carries a noindex meta). Its assets have a hash
# in every file name and never change in place, so they are cached for a year.
/showcase/*
  X-Robots-Tag: noindex

/showcase/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The sample world's lectures and book, asked for by the showcase at these root paths: not for
# search results. Cached for a day; to change a file, give it a new name.
/demo/*
  X-Robots-Tag: noindex
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400

# The landing's recordings, posters and caption cues. Cached for a day; to change one, give it a
# new name.
/media/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400

# The app's logo and illustrations, at the root because the showcase asks for them there.
/brand/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/illustrations/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# The previous one-page landing, kept frozen for reference: not for search results.
/v1/*
  X-Robots-Tag: noindex

# Images (including img/ill/) are cached for a week. They are not fingerprinted either: to change an
# image, give the new one a new file name rather than overwriting it.
/img/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Self-hosted fonts, if the site ever stops using Google Fonts. Font files never change in place.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.ico
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=86400

# robots.txt, sitemap.xml and llms.txt keep the default caching, as HTML does. Cloudflare sends .txt
# files as plain "text/plain" with no charset, so say UTF-8 here: llms.txt may carry Arabic or
# typographic characters. (HTML pages declare UTF-8 in their own <meta charset>.)
/robots.txt
  Content-Type: text/plain; charset=utf-8

/llms.txt
  Content-Type: text/plain; charset=utf-8
