# Response headers for learnklaro.com, applied by Cloudflare (Workers static assets).
# This file is read by Cloudflare and is never served. GitHub Pages ignores it (Jekyll skips "_" files).
# Docs: https://developers.cloudflare.com/workers/static-assets/headers/
#
# Rules: a block starts with a URL pattern; indented lines are headers. One "*" per pattern.
# When two blocks match one URL and set the same header, the values are JOINED with a comma, so
# never set the same header (Cache-Control above all) in two blocks that can match one URL.
# At most 100 blocks. Check after a change: curl -sI <preview URL>/<path>

# Security headers on every response. No Content-Security-Policy: the pages use inline styles,
# inline JSON-LD and Google Fonts, and a CSP would need care to not break them.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), browsing-topics=()

# Version URLs (<version>-klaro-landing.<subdomain>.workers.dev) and any workers.dev copy are
# public but must not be indexed: search engines keep to learnklaro.com.
https://:version.:subdomain.workers.dev/*
  X-Robots-Tag: noindex

# Caching. HTML gets Cloudflare's default (public, max-age=0, must-revalidate, plus an ETag), so a
# deploy shows at once; nothing below matches an HTML URL.
# CSS and JS are not fingerprinted (no hash in the file name), so they are cached for 5 minutes only:
# after a deploy, a returning visitor can get new HTML with old CSS for at most that long.
/*.css
  Cache-Control: public, max-age=300, must-revalidate

/*.js
  Cache-Control: public, max-age=300, must-revalidate

# Images are cached for a week. They are not fingerprinted either: to change an image, give the new
# one a new file name rather than overwriting it.
/img/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Self-hosted fonts, if the site ever stops using Google Fonts. Font files never change in place.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.ico
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=86400

# robots.txt, sitemap.xml and llms.txt need nothing here: they get the default caching, as HTML
# does, and .txt files are already sent as "text/plain; charset=utf-8".
